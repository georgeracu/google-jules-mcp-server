{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.georgeracu/google-jules-mcp-server",
  "description": "Model Context Protocol server for Google's Jules AI coding agent",
  "repository": {
    "url": "https://github.com/georgeracu/google-jules-mcp-server",
    "source": "github"
  },
  "version": "0.3.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "google-jules-mcp-server",
      "version": "0.3.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Jules API key, from https://jules.google.com/settings#api",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "JULES_API_KEY"
        }
      ]
    }
  ]
}
