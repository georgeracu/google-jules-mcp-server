# Get your API key from https://jules.google.com/settings#api
JULES_API_KEY=

# Opt-in: set to 1 to run tests/smoke/live-api.smoke.test.ts against the real Jules API
# (read-only, calls jules_list_sources only). Never set in CI.
JULES_LIVE_SMOKE_TEST=

# Only if your network requires a proxy. Honoured automatically, no server config
# needed. For normal use these belong in your MCP client's env block rather than
# here, since the client spawns the server and your shell environment won't reach it.
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
