{
  "name": "google-jules-mcp-server",
  "version": "0.2.0",
  "description": "Model Context Protocol server for Google's Jules AI coding agent",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "google-jules-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x build/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "keywords": [
    "mcp",
    "jules",
    "ai",
    "coding-agent",
    "model-context-protocol",
    "google"
  ],
  "author": "George Racu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgeracu/google-jules-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/georgeracu/google-jules-mcp-server/issues"
  },
  "homepage": "https://github.com/georgeracu/google-jules-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
